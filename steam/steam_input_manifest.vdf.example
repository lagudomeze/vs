{
    "actions"
    {
        "move"      { "type" "joystick" }
        "confirm"   { "type" "button" }
        "cancel"    { "type" "button" }
        "inventory" { "type" "button" }
        "character" { "type" "button" }
        "talent1"   { "type" "button" }
        "talent2"   { "type" "button" }
        "talent3"   { "type" "button" }
        "wait"      { "type" "button" }
    }

    "action_sets"
    {
