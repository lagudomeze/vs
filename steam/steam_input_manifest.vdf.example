        {
            "move"      "move"
            "confirm"   "confirm"
            "cancel"    "cancel"
            "inventory" "inventory"
            "character" "character"
            "talent1"   "talent1"
            "talent2"   "talent2"
            "talent3"   "talent3"
            "wait"      "wait"
        }
    }

    "localization"
    {
